// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dusun {
  id    String @id @default(cuid())
  nama  String
  umkms Umkm[]
}

enum UmkmStatus {
  PENDING
  APPROVED
  REJECTED
}

model Umkm {
  id             String       @id @default(cuid())
  nama           String
  pemilik        String
  kategori       String
  deskripsi      String
  alamat         String
  mapsUrl        String?
  jamOperasional String
  whatsapp       String
  fotoUtama      String
  status         UmkmStatus   @default(APPROVED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  dusunId        String
  dusun          Dusun        @relation(fields: [dusunId], references: [id], onDelete: Cascade)
  fotoProduk     FotoProduk[]
  ulasan         Ulasan[]
}

model FotoProduk {
  id     String @id @default(cuid())
  url    String
  umkmId String
  umkm   Umkm   @relation(fields: [umkmId], references: [id], onDelete: Cascade)
}

enum UlasanStatus {
  PENDING
  APPROVED
  REJECTED
}

model Ulasan {
  id        String       @id @default(cuid())
  nama      String
  rating    Int
  teks      String
  foto      String?
  status    UlasanStatus @default(PENDING)
  createdAt DateTime     @default(now())
  umkmId    String
  umkm      Umkm         @relation(fields: [umkmId], references: [id], onDelete: Cascade)
}
